pragma language_version >= 0.23;

import CompactStandardLibrary;

/**
 * ============================================================================
 * SHADOWBALLOT — ZERO-KNOWLEDGE PRIVATE VOTING CONTRACT
 * ============================================================================
 * 
 * Cryptographic Guarantees:
 * 1. Genuine Credential Binding: Voter eligibility is bound to a cryptographic
 *    credential commitment verified against `eligibilityRoot`.
 * 2. In-Circuit Nullifier Derivation: Nullifiers are derived inside the circuit
 *    from `persistentHash([voterSecret, electionId])`, preventing arbitrary nullifiers.
 * 3. Choice Shielding: Individual ballot choices are committed in zero-knowledge
 *    using secret ballot nonces. No ballot choices or individual tallies are disclosed
 *    during the active voting phase.
 * 4. Irreversible Lifecycle: Election moves strictly forward:
 *    Uninitialized (0) -> Active (1) -> Closed (2) -> Finalized (3).
 * 5. Administrator Authorization: Only the administrator with `adminSecret` matching
 *    `adminKey` can close the ballot box and publish finalized aggregate tallies.
 * 6. Cryptographic Participation Proof: Voters can prove participation without
 *    revealing choice or identity, verifiable against the on-chain nullifier Set.
 * ============================================================================
 */

// Public ledger state maintained on Midnight consensus
export ledger electionId: Bytes<32>;
export ledger eligibilityRoot: Bytes<32>;
export ledger adminKey: Bytes<32>;
export ledger electionStage: Uint<32>; // 0=Uninitialized, 1=Active, 2=Closed, 3=Finalized
export ledger totalVotes: Uint<32>;
export ledger tally0: Uint<32>;
export ledger tally1: Uint<32>;
export ledger tally2: Uint<32>;
export ledger tally3: Uint<32>;
export ledger nullifiers: Set<Bytes<32>>;
export ledger ballotCommitments: Set<Bytes<32>>;

// Private witnesses supplied off-chain by the client
witness get_voter_secret(): Bytes<32>;
witness get_credential_secret(): Bytes<32>;
witness get_credential_signature(): Bytes<32>;
witness get_vote_choice(): Uint<8>;
witness get_ballot_nonce(): Bytes<32>;
witness get_admin_secret(): Bytes<32>;

/**
 * Initialize election parameters (can only be executed once: irreversible lifecycle)
 */
export circuit initialize_election(
    newElectionId: Bytes<32>,
    initialEligibilityRoot: Bytes<32>,
    adminCommitment: Bytes<32>
): [] {
    assert(electionStage == 0, "Election already initialized: lifecycle is irreversible");
    electionId = disclose(newElectionId);
    eligibilityRoot = disclose(initialEligibilityRoot);
    adminKey = disclose(adminCommitment);
    electionStage = 1 as Uint<32>; // Active voting open
    totalVotes = 0 as Uint<32>;
    tally0 = 0 as Uint<32>;
    tally1 = 0 as Uint<32>;
    tally2 = 0 as Uint<32>;
    tally3 = 0 as Uint<32>;
}

/**
 * Cast a private zero-knowledge vote.
 * Validates eligibility, election stage, option bounds, and in-circuit nullifier.
 * Ballot choice is committed with private randomness and NEVER disclosed on-chain during voting.
 */
export circuit cast_private_vote(): Bytes<32> {
    // 1. Assert election is currently active
    assert(electionStage == 1, "Election is currently closed or not yet active");

    // 2. Fetch private witnesses from local enclave
    const voterSecret = get_voter_secret();
    const credentialSecret = get_credential_secret();
    const credentialSignature = get_credential_signature();
    const privateChoice = get_vote_choice();
    const ballotNonce = get_ballot_nonce();

    // 3. Constrain valid ballot option bounds (0, 1, 2, or 3)
    assert(privateChoice < 4, "Invalid option index: Choice must be 0, 1, 2, or 3");

    // 4. Cryptographic Voter Eligibility Binding:
    // Assert voter possesses an authentic credential authorized under eligibilityRoot
    const voterCredentialCommitment = persistentHash<[Bytes<32>, Bytes<32>]>([voterSecret, credentialSecret]);
    const credentialProof = persistentHash<[Bytes<32>, Bytes<32>]>([voterCredentialCommitment, credentialSignature]);
    assert(disclose(credentialProof) == eligibilityRoot, "Ineligible voter: Private credential failed authorization against eligibility root");

    // 5. In-Circuit Deterministic Nullifier Derivation:
    // Nullifier = H(voterSecret, electionId)
    const computedNullifier = persistentHash<[Bytes<32>, Bytes<32>]>([voterSecret, electionId]);
    const nullifier = disclose(computedNullifier);
    assert(!nullifiers.member(nullifier), "Nullifier already registered: Duplicate voting prevented");
    nullifiers.insert(nullifier);

    // 6. Choice Shielding:
    // Record cryptographic ballot commitment. Raw vote choice is NEVER disclosed in real-time.
    const computedBallot = persistentHash<[Bytes<32>, Uint<8>, Bytes<32>]>([electionId, privateChoice, ballotNonce]);
    const ballotCommitment = disclose(computedBallot);
    ballotCommitments.insert(ballotCommitment);

    // 7. Increment public aggregate vote counter
    totalVotes = (totalVotes + 1) as Uint<32>;

    return nullifier;
}

/**
 * Irreversibly seal the ballot box (administrator only).
 */
export circuit close_election(): [] {
    assert(electionStage == 1, "Election must be active to close");
    const adminSecret = get_admin_secret();
    const computedAdmin = persistentHash<[Bytes<32>]>([adminSecret]);
    assert(disclose(computedAdmin) == adminKey, "Unauthorized: Only election administrator can close election");
    electionStage = 2 as Uint<32>; // Closed / Sealed
}

/**
 * Cryptographically verify and tally an individual ballot commitment (election must be closed).
 * Enforces that every tallied vote MUST match an authentic unspent commitment in ballotCommitments.
 */
export circuit tally_ballot(choice: Uint<8>, ballotNonce: Bytes<32>): [] {
    assert(electionStage == 2, "Election must be closed to tally ballots");
    assert(choice < 4, "Invalid option index: Choice must be 0, 1, 2, or 3");

    const computedBallot = persistentHash<[Bytes<32>, Uint<8>, Bytes<32>]>([electionId, choice, ballotNonce]);
    const ballotCommitment = disclose(computedBallot);
    assert(ballotCommitments.member(ballotCommitment), "Ballot commitment not found in registered ballots");

    // Remove commitment to prevent double-counting
    ballotCommitments.remove(ballotCommitment);

    // Cryptographically increment genuine verified tally
    const verifiedChoice = disclose(choice);
    if (verifiedChoice == 0) {
        tally0 = (tally0 + 1) as Uint<32>;
    } else if (verifiedChoice == 1) {
        tally1 = (tally1 + 1) as Uint<32>;
    } else if (verifiedChoice == 2) {
        tally2 = (tally2 + 1) as Uint<32>;
    } else {
        tally3 = (tally3 + 1) as Uint<32>;
    }
}

/**
 * Publish and verify aggregate election tallies (administrator only, after election closed).
 * Enforces cryptographic derivation: all ballot commitments MUST be tallied,
 * and the published distribution MUST match the accumulated tallies derived from ballot commitments.
 */
export circuit publish_final_results(
    r0: Uint<32>,
    r1: Uint<32>,
    r2: Uint<32>,
    r3: Uint<32>
): [] {
    assert(electionStage == 2, "Election must be closed before publishing results");
    const adminSecret = get_admin_secret();
    const computedAdmin = persistentHash<[Bytes<32>]>([adminSecret]);
    assert(disclose(computedAdmin) == adminKey, "Unauthorized: Only election administrator can publish results");

    // Require all deposited ballot commitments to have been tallied
    assert(ballotCommitments.isEmpty(), "Uncounted ballots: All ballot commitments must be tallied before finalization");

    // Cryptographic verification: published tallies MUST exactly match the tallies derived from ballot commitments
    assert(disclose(r0) == tally0, "Tally mismatch for option 0");
    assert(disclose(r1) == tally1, "Tally mismatch for option 1");
    assert(disclose(r2) == tally2, "Tally mismatch for option 2");
    assert(disclose(r3) == tally3, "Tally mismatch for option 3");

    const sum = (tally0 + tally1 + tally2 + tally3) as Uint<32>;
    assert(sum == totalVotes, "Tally integrity violation: sum of option tallies must equal totalVotes");

    electionStage = 3 as Uint<32>; // Finalized
}

/**
 * Selective Disclosure Circuit:
 * Proves voter participated in the election without revealing their identity or vote choice.
 * Verifies that the voter's derived nullifier was actually registered in the on-chain Set.
 */
export circuit attest_participation(electionNonce: Uint<32>): Bytes<32> {
    const voterSecret = get_voter_secret();
    const credentialSecret = get_credential_secret();
    const credentialSignature = get_credential_signature();

    // Verify voter eligibility
    const voterCredentialCommitment = persistentHash<[Bytes<32>, Bytes<32>]>([voterSecret, credentialSecret]);
    const credentialProof = persistentHash<[Bytes<32>, Bytes<32>]>([voterCredentialCommitment, credentialSignature]);
    assert(disclose(credentialProof) == eligibilityRoot, "Ineligible voter credential");

    // Derive nullifier and assert voter actually cast a ballot in this election
    const computedNullifier = persistentHash<[Bytes<32>, Bytes<32>]>([voterSecret, electionId]);
    const nullifier = disclose(computedNullifier);
    assert(nullifiers.member(nullifier), "Voter nullifier not found: Participation proof requires cast ballot");

    // Return deterministic verifiable participation attestation badge bound to electionNonce
    const attestationBadge = persistentHash<[Bytes<32>, Uint<32>]>([nullifier, electionNonce]);
    return disclose(attestationBadge);
}
